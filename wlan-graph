    mx.strokeStyle = line; mx.globalAlpha = .6; mx.beginPath(); mx.moveTo(cx+Math.cos(a0)*R0, cy+Math.sin(a0)*R0); mx.lineTo(cx+Math.cos(a0)*R, cy+Math.sin(a0)*R); mx.stroke(); mx.globalAlpha = 1;
    const am = a0 + w/2; mx.fillStyle = dim; mx.font = '600 11px system-ui'; mx.textAlign = 'center';
    mx.fillText(n, cx+Math.cos(am)*(R-10), cy+Math.sin(am)*(R-10)+4);
    list.forEach((dv, i) => {
      const a = a0 + w*(i+0.5)/list.length, r = rad(dv.rssi), x = cx+Math.cos(a)*r, y = cy+Math.sin(a)*r;
      const on = S.sel.includes(dv.mac), faded = S.sel.length && !on;
      mx.globalAlpha = faded ? .3 : 1;
      if (on){ mx.strokeStyle = css('--accent'); mx.lineWidth = 3; mx.beginPath(); mx.arc(x,y,10,0,TAU); mx.stroke(); }
      mx.fillStyle = bandCol(dv.band); mx.beginPath(); mx.arc(x,y,on?7:5,0,TAU); mx.fill();
      if (dv.me){ mx.strokeStyle = fg; mx.lineWidth = 1.5; mx.beginPath(); mx.arc(x,y,8,0,TAU); mx.stroke(); }
      mx.fillStyle = fg; mx.font = (on ? '700 ' : '') + '11px system-ui'; mx.textAlign = 'center';
      mx.fillText(devLabel(dv), x, y+(on?22:17));
      mx.globalAlpha = 1;
      mapHit.push({x, y, mac: dv.mac});
    });
