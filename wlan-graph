  }
}
mv.addEventListener('click', e => {
  const r = mv.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
  let best = null, bd = 26;
  for (const h of mapHit){ const d = Math.hypot(h.x-x, h.y-y); if (d < bd){ bd = d; best = h; } }
  if (best) toggle(best.mac);
});

// ---------- Kerzen-Chart
const cv = $('c'), ctx = cv.getContext('2d');
let hit = [];
function drawChart(cs, ti){
  const dpr = devicePixelRatio || 1, W = cv.clientWidth, H = cv.clientHeight;
  if (cv.width !== W*dpr || cv.height !== H*dpr){ cv.width = W*dpr; cv.height = H*dpr; }
  ctx.setTransform(dpr,0,0,dpr,0,0); ctx.clearRect(0,0,W,H);
  const fg = css('--fg'), dim = css('--dim'), line = css('--line'), M = METRICS[S.metric];
  const L = 44, R = 10, T = 18, B = 34;
  // nur so viele Kerzen, wie hinpassen (die neuesten)
  const fitN = Math.max(3, Math.floor((W-L-R)/30)), off = Math.max(0, cs.length - fitN), show = cs.slice(off);
  const last = cur().samples[cur().samples.length-1], live = last ? sampleVal(last) : null;
  const vals = show.filter(Boolean).flatMap(c => [c.lo, c.hi]); if (live !== null) vals.push(live);
  if (!vals.length){ ctx.fillStyle = dim; ctx.font = '13px system-ui'; ctx.fillText('sammelt Messwerte …', L, H/2); hit = []; return; }
  let lo = Math.min(...vals), hi = Math.max(...vals);
  if (S.metric === 'good'){ lo = Math.max(0, Math.floor(lo)-1); hi = Math.ceil(hi)+1; }
  else { const pad = Math.max((hi-lo)*0.15, S.metric === 'dbm' ? 2 : 3); lo -= pad; hi += pad; }
  const y = v => T + (hi - v)/(hi - lo)*(H-T-B);
  // Achse
  ctx.font = '11px system-ui'; ctx.textAlign = 'right'; ctx.strokeStyle = line; ctx.lineWidth = 1;
  const step = niceStep((hi-lo)/5, S.metric === 'good');
  for (let v = Math.ceil(lo/step)*step; v <= hi; v += step){
    ctx.globalAlpha = .6; ctx.beginPath(); ctx.moveTo(L, y(v)); ctx.lineTo(W-R, y(v)); ctx.stroke(); ctx.globalAlpha = 1;
    ctx.fillStyle = dim; ctx.fillText(M.fmt(v), L-6, y(v)+4);
  }
  // Topscore-Linie
  if (ti >= 0){
    ctx.strokeStyle = css('--top'); ctx.setLineDash([5,4]); ctx.globalAlpha = .7;
    ctx.beginPath(); ctx.moveTo(L, y(cs[ti].med)); ctx.lineTo(W-R, y(cs[ti].med)); ctx.stroke(); ctx.setLineDash([]); ctx.globalAlpha = 1;
  }
  const slot = Math.min(80, (W-L-R)/Math.max(show.length, 4)), bw = Math.max(8, Math.min(26, slot*0.5));
  hit = [];
  let prev = null; for (let i = off-1; i >= 0; i--) if (cs[i]){ prev = cs[i]; break; }
  show.forEach((c, j) => {
    const i = off + j, x = L + slot*(j+0.5), isCur = i === cs.length-1;
    ctx.textAlign = 'center'; ctx.fillStyle = isCur ? fg : dim; ctx.font = (isCur ? '600 ' : '') + '11px system-ui';
    ctx.fillText(short(S.segs[i].name, slot), x, H-B+16);
    if (i === ti){ ctx.fillStyle = css('--top'); ctx.font = '700 12px system-ui'; ctx.fillText('★', x, H-B+30); }
    if (!c){ ctx.strokeStyle = dim; ctx.setLineDash([3,3]); ctx.strokeRect(x-bw/2, T+4, bw, H-T-B-8); ctx.setLineDash([]); hit.push({x, i, c}); return; }
    const col = !prev ? css('--accent') : c.med > prev.med + 1e-9 ? css('--good') : c.med < prev.med - 1e-9 ? css('--bad') : dim;
    prev = c;
    ctx.strokeStyle = col; ctx.fillStyle = col; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(x, y(c.hi)); ctx.lineTo(x, y(c.lo)); ctx.stroke();               // Docht
    const top = y(c.q3), h = Math.max(2, y(c.q1) - top);
    ctx.globalAlpha = .35; ctx.fillRect(x-bw/2, top, bw, h); ctx.globalAlpha = 1; ctx.strokeRect(x-bw/2, top, bw, h);  // Körper
    ctx.lineWidth = 2.5; ctx.beginPath(); ctx.moveTo(x-bw/2, y(c.med)); ctx.lineTo(x+bw/2, y(c.med)); ctx.stroke();   // Median
    if (i === ti){ ctx.strokeStyle = css('--top'); ctx.lineWidth = 2; ctx.strokeRect(x-bw/2-4, top-4, bw+8, h+8); }
    hit.push({x, i, c});
  });
  // Live-Punkt auf der aktuellen Kerze
  if (live !== null && cs.length - 1 >= off){
    const x = L + slot*(cs.length-1-off+0.5);
    ctx.fillStyle = fg; ctx.beginPath(); ctx.arc(x, y(live), 4.5, 0, 7); ctx.fill();
    ctx.strokeStyle = css('--bg'); ctx.lineWidth = 1.5; ctx.stroke();
  }
}
function niceStep(raw, int){
  const p = Math.pow(10, Math.floor(Math.log10(raw || 1))), m = raw/p;
  const s = (m <= 1 ? 1 : m <= 2 ? 2 : m <= 5 ? 5 : 10) * p;
  return int ? Math.max(1, Math.round(s)) : s;
}
function short(s, w){ ctx.font = '11px system-ui'; if (ctx.measureText(s).width <= w-4) return s; const m = s.match(/(\d+)$/); return m ? '#'+m[1] : s.slice(0, Math.max(2, Math.floor(w/7)))+'…'; }

cv.addEventListener('mousemove', e => showCTip(e.offsetX, e.offsetY));
cv.addEventListener('mouseleave', () => $('ctip').style.display = 'none');
cv.addEventListener('touchstart', e => { const r = cv.getBoundingClientRect(), t = e.touches[0]; showCTip(t.clientX-r.left, t.clientY-r.top); }, {passive:true});
function showCTip(mx, my){
  const h = hit.reduce((b, p) => Math.abs(p.x-mx) < Math.abs((b?.x ?? 1e9)-mx) ? p : b, null), tip = $('ctip');
  if (!h || Math.abs(h.x-mx) > 40){ tip.style.display = 'none'; return; }
  const f = METRICS[S.metric].fmt, c = h.c;
  tip.innerHTML = `<b>${S.segs[h.i].name}</b><br>` + (c ? `Median ${f(c.med)} · Bereich ${f(c.lo)}–${f(c.hi)}<br>${c.n} Messungen` : 'noch keine Messwerte');
  tip.style.display = 'block';
  tip.style.left = Math.max(0, Math.min(mx+12, cv.clientWidth - tip.offsetWidth)) + 'px'; tip.style.top = Math.max(0, my-50) + 'px';
}

// ---------- Bedienung
for (const [v, l] of BANDS){ const b = document.createElement('button'); b.dataset.v = v; b.textContent = l; b.onclick = () => { S.band = v; save(); render(); }; $('bands').append(b); }
for (const [v, m] of Object.entries(METRICS)){ const b = document.createElement('button'); b.dataset.v = v; b.textContent = m.lbl; b.title = m.desc; b.onclick = () => { S.metric = v; wasTop = null; save(); render(); }; $('metrics').append(b); }
function next(){ S.n = (S.n||S.segs.length) + 1; S.segs.push(newSeg(S.n)); save(); render(); }
$('next').onclick = next;
$('redo').onclick = () => { const s = cur(); s.samples = []; s.t0 = Date.now(); save(); render(); };
let armed = 0;
$('reset').onclick = () => {
  if (Date.now() - armed > 3000){ armed = Date.now(); $('reset').textContent = 'wirklich? nochmal tippen'; setTimeout(() => $('reset').textContent = 'alles löschen', 3000); return; }
  S = {segs:[newSeg(1)], band:S.band, metric:S.metric, names:{}, n:1}; wasTop = null; armed = 0; $('reset').textContent = 'alles löschen'; save(); render();
};
$('devs').addEventListener('click', e => { const tr = e.target.closest('tr[data-mac]'); if (tr) toggle(tr.dataset.mac); });
$('selall').onclick = () => { S.sel = []; wasTop = null; save(); render(); };
$('pos').addEventListener('input', e => { cur().name = e.target.value || 'Position'; save(); });
$('pos').addEventListener('keydown', e => { if (e.key === 'Enter') e.target.blur(); });
addEventListener('keydown', e => { if (e.code === 'Space' && document.activeElement.tagName !== 'INPUT'){ e.preventDefault(); next(); } });
addEventListener('resize', render);

poll(); setInterval(poll, 2500); setInterval(render, 1000);
</script></body></html>
