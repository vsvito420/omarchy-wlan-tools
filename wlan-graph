</style></head><body>
<canvas id="c"></canvas>
<div id="top"><h1>WLAN-Graph</h1><span id="info">lade …</span><a href="ausrichten">Antenne ausrichten →</a></div>
<div id="err"></div>
<div id="legend"><b>Abstand zur Mitte = Empfang</b> · Ringe in dBm, innen = gut
  <span class="dot" style="background:var(--b24)"></span>2,4 GHz
  <span class="dot" style="background:var(--b5)"></span>5 GHz
  <span class="dot" style="background:var(--b6)"></span>6 GHz
  · <span style="color:var(--good)">gut</span> / <span style="color:var(--ok)">mittel</span> / <span style="color:var(--bad)">schlecht</span>
  · Zoom per Rad/2 Finger, Doppelklick = einpassen</div>
<div id="tip"></div>
<script>
// Radar-Ansicht: Router in der Mitte, Abstand zur Mitte = Signalstärke (Ringe in dBm),
// jedes WLAN bekommt einen Kuchenstück-Sektor. Alle WLANs kommen vom selben Router,
// darum zählt nur der Abstand zur Mitte.
const cv = document.getElementById('c'), ctx = cv.getContext('2d');
const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
let W, H, dpr;
function resize(){ dpr = devicePixelRatio||1; W = innerWidth; H = innerHeight; cv.width = W*dpr; cv.height = H*dpr; }
addEventListener('resize', resize); resize();

const nodes = new Map();   // id -> {x, y, tx, ty, ...}
let sectors = [], DATA = null, OUTER = -70;
const view = {x:0, y:0, k:1};
let auto = true;           // Ansicht automatisch einpassen, bis man selbst zoomt/verschiebt
let hover = null, panning = null;

const R_IN = 70, PX_DB = 8, DB_TOP = -30, DB_LOW = -90;  // -30 dBm = Innenkreis, je dB 8 px nach außen
const rad = r => R_IN + (DB_TOP - Math.max(DB_LOW, Math.min(DB_TOP, r))) * PX_DB;
const RINGS = [-40, -50, -60, -70, -80, -90];
const HUB_R = 42;
const quality = r => r >= -60 ? css('--good') : r >= -70 ? css('--ok') : css('--bad');
const bandCol = b => css(b==='2.4' ? '--b24' : b==='5' ? '--b5' : '--b6');
const devLabel = dv => dv.me ? (dv.name||'dieser PC')+' (du)' : dv.name || (dv.ip ? '.'+dv.ip.split('.').pop() : dv.mac.slice(-8));

function place(id, init, tx, ty){
  let n = nodes.get(id);
  if (!n){ n = {x:tx*0.3, y:ty*0.3}; nodes.set(id, n); }
  Object.assign(n, init, {tx, ty, seen:gen}); return n;
}
let gen = 0;

async function load(){
  try{
    const d = await (await fetch('data')).json();
    document.getElementById('err').textContent = d.error ? 'Fehler: '+d.error : '';
    DATA = d; gen++;
    place('router', {type:'router', label:'Router', r:12}, 0, 0);
    const names = [...new Set([...Object.keys(d.ssids), ...d.devices.map(x=>x.ssid)])].sort();
    const by = Object.fromEntries(names.map(s => [s, d.devices.filter(x=>x.ssid===s).sort((a,b)=>a.mac<b.mac?-1:1)]));
    // Sektorbreite nach Geräteanzahl, leere WLANs bekommen ein schmales Stück
    const wt = s => Math.max(0.7, by[s].length), tot = names.reduce((a,s)=>a+wt(s), 0);
    let a0 = -Math.PI/2 - Math.PI*wt(names[0])/tot;   // erstes WLAN mittig oben
    sectors = names.map(s => { const w = 2*Math.PI*wt(s)/tot, sec = {s, a0, a1:a0+w}; a0 += w; return sec; });
    for (const sec of sectors){
      const am = (sec.a0+sec.a1)/2, list = by[sec.s];
      place('ssid:'+sec.s, {type:'hub', label:sec.s, sub:(d.ssids[sec.s]||[]).map(b=>b+' GHz').join(' · '), r:7, ssid:sec.s, count:list.length},
            Math.cos(am)*HUB_R, Math.sin(am)*HUB_R);
      list.forEach((dv, i) => {
        const a = sec.a0 + (sec.a1-sec.a0)*(i+0.5)/list.length, r = rad(dv.rssi);
        place('dev:'+dv.mac, {type:'dev', label:devLabel(dv), dev:dv, r: dv.me ? 7 : 5, hub:'ssid:'+sec.s}, Math.cos(a)*r, Math.sin(a)*r);
      });
    }
    for (const [id, n] of nodes) if (n.seen !== gen) nodes.delete(id);
    OUTER = Math.max(DB_LOW, Math.min(-70, Math.floor((Math.min(0, ...d.devices.map(x=>x.rssi)) - 1) / 10) * 10));
    document.getElementById('info').textContent = `${d.devices.length} Geräte · ${names.length} Netze · Stand ${d.time} · alle 3 s`;
  }catch(e){ document.getElementById('err').textContent = 'Keine Verbindung zum Server'; }
}
load(); setInterval(load, 3000);

// Ansicht so einpassen, dass das schwächste Gerät samt Beschriftung sichtbar ist
function fit(){
  if (!auto) return;
  const ext = rad(OUTER) + 6;   // WLAN-Namen stehen innen am Rand
  const top = document.getElementById('top').getBoundingClientRect().bottom + 8;
  const bot = H - document.getElementById('legend').getBoundingClientRect().top + 8;
  const k = Math.min((W-24)/(2*ext+120), (H-top-bot)/(2*ext));   // seitlich Platz für WLAN-Namen
  view.k += (k - view.k)*0.2; view.x += (0 - view.x)*0.2; view.y += ((top-bot)/2 - view.y)*0.2;
}

function tick(){
  for (const n of nodes.values()){ n.x += (n.tx-n.x)*0.12; n.y += (n.ty-n.y)*0.12; }
  fit();
}

function draw(){
  ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.fillStyle = css('--bg'); ctx.fillRect(0,0,W,H);
  ctx.translate(W/2+view.x, H/2+view.y); ctx.scale(view.k, view.k);
  const fg=css('--fg'), dim=css('--dim'), acc=css('--accent'), line=css('--line'), px = 1/view.k;
  const fs = s => `${s/Math.max(view.k,0.55)}px system-ui`;

  // Güte-Zonen als zarte Ringe: grün bis -60, gelb bis -70, rot darüber
  const TAU = Math.PI*2;
  const zone = (r0, r1, col) => {
    r1 = Math.max(r1, OUTER); if (r0 <= r1) return;
    ctx.globalAlpha = 0.08; ctx.fillStyle = col; ctx.beginPath();
    ctx.arc(0,0,rad(r1),0,TAU); ctx.moveTo(rad(r0),0); ctx.arc(0,0,rad(r0),TAU,0,true); ctx.fill();
  };
  ctx.globalAlpha = 0.08; ctx.fillStyle = css('--good'); ctx.beginPath(); ctx.arc(0,0,rad(-60),0,TAU); ctx.fill();
  zone(-60, -70, css('--ok')); zone(-70, DB_LOW, css('--bad'));
  ctx.globalAlpha = 1;
  // dBm-Ringe mit Beschriftung
  ctx.strokeStyle = line; ctx.lineWidth = px; ctx.setLineDash([4*px, 4*px]);
  for (const r of RINGS) if (r >= OUTER){ ctx.beginPath(); ctx.arc(0,0,rad(r),0,Math.PI*2); ctx.stroke(); }
  ctx.setLineDash([]);
  ctx.fillStyle = dim; ctx.font = fs(10); ctx.textAlign = 'left';
  for (const r of RINGS) if (r >= OUTER){ const a = -Math.PI/4, rr = rad(r); ctx.fillText(r+' dBm', Math.cos(a)*rr+3*px, Math.sin(a)*rr-3*px); }
  // Sektorgrenzen
  ctx.strokeStyle = line; ctx.globalAlpha = 0.6;
  for (const s of sectors){ ctx.beginPath(); ctx.moveTo(Math.cos(s.a0)*R_IN*0.8, Math.sin(s.a0)*R_IN*0.8); ctx.lineTo(Math.cos(s.a0)*rad(OUTER), Math.sin(s.a0)*rad(OUTER)); ctx.stroke(); }
  ctx.globalAlpha = 1;

  // beim Zeigen: Gerät + sein WLAN bzw. WLAN + seine Geräte hervorheben
  const on = n => !hover || n.type==='router' || n===hover || (hover.type==='dev' && 'ssid:'+n.ssid===hover.hub) || (hover.type==='hub' && n.hub==='ssid:'+hover.ssid);

  // Linien WLAN -> Gerät, Farbe = Empfang
  for (const n of nodes.values()){
    if (n.type!=='dev') continue;
    const h = nodes.get(n.hub); if (!h) continue;
    ctx.globalAlpha = on(n) ? 0.7 : 0.1; ctx.strokeStyle = quality(n.dev.rssi); ctx.lineWidth = 1.2*px;
    ctx.beginPath(); ctx.moveTo(h.x,h.y); ctx.lineTo(n.x,n.y); ctx.stroke();
  }
  // Punkte und Beschriftungen
  for (const n of nodes.values()){
    ctx.globalAlpha = on(n) ? 1 : 0.2;
    const col = n.type==='router' ? fg : n.type==='hub' ? acc : bandCol(n.dev.band);
    if (n.dev && n.dev.me){ ctx.strokeStyle=fg; ctx.lineWidth=2*px; ctx.beginPath(); ctx.arc(n.x,n.y,n.r+4,0,7); ctx.stroke(); }
    ctx.fillStyle = col; ctx.beginPath(); ctx.arc(n.x,n.y,n===hover?n.r+2:n.r,0,7); ctx.fill();
    ctx.textAlign = 'center';
    if (n.type==='dev'){
      ctx.fillStyle = fg; ctx.font = fs(11); n.lx = n.x; n.ly = n.y+n.r+13/Math.max(view.k,0.55) - 4*px; n.lw = ctx.measureText(n.label).width;
      ctx.fillText(n.label, n.x, n.y+n.r+13/Math.max(view.k,0.55));
    } else if (n.type==='hub'){
      // WLAN-Name innen am äußeren Rand des Sektors, Punkt innen am Router
      const a = Math.atan2(n.ty, n.tx), rr = R_IN*0.62;
      ctx.fillStyle = fg; ctx.font = '600 '+fs(12); n.lx = Math.cos(a)*(rad(OUTER)-24*px); n.ly = Math.sin(a)*(rad(OUTER)-24*px)+4*px; n.lw = Math.max(ctx.measureText(n.label).width, 60*px);
      ctx.fillText(n.label, Math.cos(a)*(rad(OUTER)-24*px), Math.sin(a)*(rad(OUTER)-24*px)-2*px);
      ctx.fillStyle = dim; ctx.font = fs(10); ctx.fillText(`${n.count} · ${n.sub}`, Math.cos(a)*(rad(OUTER)-24*px), Math.sin(a)*(rad(OUTER)-24*px)+11*px);
    }
  }
  ctx.globalAlpha = 1;
}
(function loop(){ tick(); draw(); requestAnimationFrame(loop); })();

const toWorld = (mx,my) => [(mx-W/2-view.x)/view.k, (my-H/2-view.y)/view.k];
// Trefferprüfung in Bildschirm-Pixeln: Punkt oder Beschriftung; mit dem Finger großzügiger
function pick(mx, my, tol = 12){
