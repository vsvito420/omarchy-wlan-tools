#!/usr/bin/env python3
"""wlan-graph – Live-Graph aller WLAN-Geraete am ASUS-Router (Obsidian-Stil).

--demo zeigt erfundene Netze/Geraete (zufaellige Namen).
--ausrichten oeffnet die Seite zum Ausrichten der Router-Antennen (/ausrichten).

Startet einen kleinen lokalen Server (127.0.0.1:8765) und oeffnet die Seite als
Omarchy-Web-App. Der Server beendet sich selbst, wenn die Seite zu ist.
"""
import http.server, json, os, re, socket, subprocess, sys, threading, time

# Einstellungen aus ~/.config/wlan-tools/config (siehe config.example); ohne Datei: Standard-Gateway
def _cfg():
    c = {}
    try:
        for line in open(os.path.expanduser("~/.config/wlan-tools/config")):
            k, _, v = line.strip().partition("=")
            if k and not k.startswith("#"):
                c[k.strip()] = v.strip().strip("\"'")
    except OSError:
        pass
    if not c.get("ROUTER_HOST"):
        r = subprocess.run(["ip", "-4", "route", "show", "default"], capture_output=True, text=True).stdout.split()
        c["ROUTER_HOST"] = r[r.index("via") + 1] if "via" in r else "192.168.1.1"
    return c


CFG = _cfg()
ROUTER_IP = CFG["ROUTER_HOST"]
ROUTER_LOGIN = f"{CFG.get('ROUTER_USER', 'admin')}@{ROUTER_IP}"
ROUTER_PORT = CFG.get("ROUTER_PORT", "22")

PORT = 8766 if "--demo" in sys.argv else 8765
ROUTER = ["ssh", "-q", "-p", ROUTER_PORT, "-o", "BatchMode=yes",
          "-o", "ControlMaster=auto", "-o", f"ControlPath={os.environ.get('XDG_RUNTIME_DIR', '/tmp')}/wlan-graph-ssh",
          "-o", "ControlPersist=60", ROUTER_LOGIN]
IDLE_EXIT = 45  # Sekunden ohne Abfrage -> Server beendet sich
# --lan: fürs Handy im Heimnetz – eigener Port, auf allen Adressen, nur mit geheimem Link
LAN = "--lan" in sys.argv
LAN_PORT = 8775
LAN_IDLE = 3600  # Handy-Browser pausieren im Hintergrund, darum großzügiger
TOKEN_FILE = os.path.expanduser("~/.local/state/wlan-graph/token")

REMOTE = r'''
for d in /sys/class/net/ath*; do
  i=${d##*/}
  iwconfig $i 2>/dev/null | awk -v i=$i '
    /ESSID/ { match($0, /ESSID:"[^"]*"/); s = substr($0, RSTART + 7, RLENGTH - 8) }
    /Frequency/ { match($0, /Frequency:[0-9.]+/); f = substr($0, RSTART + 10, RLENGTH - 10) }
    END { if (f != "") printf "VAP\t%s\t%s\t%s\n", i, f, s }'
  wlanconfig $i list sta 2>/dev/null | awk -v i=$i '
    $1 ~ /^[0-9a-f][0-9a-f]:/ {
      mode = ""; at = ""
      for (k = 12; k <= NF; k++) {
        if ($k ~ /^IEEE80211_MODE_/) mode = substr($k, 16)
        if ($k ~ /^[0-9]+:[0-9]+:[0-9]+$/) at = $k
      }
      printf "STA\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", i, $1, $6, $4, $5, mode, at, $7, $8
      last = $1
    }
    /MLD Addr/ { printf "MLD\t%s\t%s\n", last, $NF }'
done
awk '{ printf "LEASE\t%s\t%s\t%s\n", $2, $3, $4 }' /var/lib/misc/dnsmasq.leases 2>/dev/null
awk 'NR > 1 && $4 != "00:00:00:00:00:00" { printf "ARP\t%s\t%s\n", $4, $1 }' /proc/net/arp 2>/dev/null
'''

last_hit = time.time()
cache = {"t": 0, "data": None}
lock = threading.Lock()


def local_macs():
    macs = set()
    for n in os.listdir("/sys/class/net"):
        try:
            macs.add(open(f"/sys/class/net/{n}/address").read().strip().lower())
        except OSError:
            pass
    return macs


def band(freq):
    f = float(freq)
    return "2.4" if f < 3 else "5" if f < 5.9 else "6"


def fetch():
    env = dict(os.environ)
    env.setdefault("SSH_AUTH_SOCK", f"{os.environ.get('XDG_RUNTIME_DIR')}/gcr/ssh")
    out = subprocess.run(ROUTER + [REMOTE], capture_output=True, text=True, timeout=20, env=env).stdout
    vaps, stas, leases, mld, arp = {}, [], {}, {}, {}
    for line in out.splitlines():
        p = line.split("\t")
        if p[0] == "VAP" and len(p) >= 4:
            vaps[p[1]] = {"freq": p[2], "ssid": p[3]}
        elif p[0] == "STA" and len(p) >= 10:
            stas.append(p[1:])
        elif p[0] == "MLD" and len(p) >= 3:
            mld[p[1].lower()] = p[2].lower()   # Wi-Fi 7 MLO: zufällige Band-Adresse -> echte Geräte-MAC
        elif p[0] == "ARP" and len(p) >= 3:
            arp.setdefault(p[1].lower(), p[2])
        elif p[0] == "LEASE" and len(p) >= 4:
            leases[p[1].lower()] = (p[2], p[3])
    mine = local_macs()
    ssids = {}
    for v in vaps.values():
        s = v["ssid"]
        if not s or re.fullmatch(r"[0-9A-F]{32}", s):   # interne/versteckte Router-Netze
            continue
        ssids.setdefault(s, set()).add(band(v["freq"]))
    devices = []
    for vap, mac, rssi, tx, rx, mode, at, rmin, rmax in stas:
        v = vaps.get(vap, {})
        mac = mld.get(mac.lower(), mac)
        ip, name = leases.get(mac.lower(), ("", ""))
        if not ip and mac.lower() in arp:   # z. B. ASUS-Repeater: WLAN-MAC ≠ MAC, mit der die IP geholt wurde
            ip = arp[mac.lower()]
            name = next((n for i, n in leases.values() if i == ip), "")
        devices.append({
            "mac": mac.lower(), "ssid": v.get("ssid", "?"), "band": band(v.get("freq", "0")),
            "rssi": int(rssi), "rmin": int(rmin) if rmin.lstrip("-").isdigit() else None,
            "rmax": int(rmax) if rmax.lstrip("-").isdigit() else None,
            "tx": tx, "rx": rx, "mode": mode, "since": at, "ip": ip,
            "name": "" if name in ("*", "") else name, "me": mac.lower() in mine,
        })
    return {"ssids": {k: sorted(v) for k, v in ssids.items()}, "devices": devices, "time": time.strftime("%H:%M:%S")}


DEMO = "--demo" in sys.argv   # erfundene Netze und Geräte, z. B. für Screenshots
_demo = []


def demo_data():
    import random
    if not _demo:
        words = ["Kaktus", "Nebel", "Pixel", "Falke", "Orbit", "Wolke", "Mango", "Funke", "Quarz", "Komet", "Lotus", "Biber"]
        nets = [f"{w}-{random.randint(10, 99)}" for w in random.sample(words, 3)]
        bands = [["2.4", "5"], ["6"], ["2.4", "5", "6"]]
        kinds = ["PC", "Handy", "Laptop", "TV", "Tablet", "Konsole", "Drucker", "Lampe", "Steckdose", "Uhr", "Lautsprecher", "Kamera"]
        for i in range(random.randint(14, 20)):
            k = random.randrange(3)
            _demo.append({"mac": "02:" + ":".join(f"{random.randrange(256):02x}" for _ in range(5)),
                          "ssid": nets[k], "band": random.choice(bands[k]), "base": random.randint(-82, -38),
                          "ip": f"192.168.1.{random.randint(20, 250)}", "mode": random.choice(["11AXA_HE160", "11BEA_EHT160", "11NG_HT20"]),
                          "name": f"{kinds[i % len(kinds)]}-{i + 1}" if random.random() > .15 else "", "me": i == 0})
        _demo.append({"ssids": {n: b for n, b in zip(nets, bands)}})
    devs = []
    for d in _demo[:-1]:
        r = d["base"] + random.randint(-3, 3)
        devs.append({**{k: v for k, v in d.items() if k != "base"}, "rssi": r, "rmin": r - 4, "rmax": r + 3,
                     "tx": f"{random.randint(100, 2400)}M", "rx": f"{random.randint(100, 2400)}M", "since": "01:23:45"})
    return {"ssids": _demo[-1]["ssids"], "devices": devs, "time": time.strftime("%H:%M:%S")}


def get_data():
    if DEMO:
        return demo_data()
    with lock:
        if time.time() - cache["t"] > 2.5 or cache["data"] is None:
            try:
                cache["data"] = fetch()
            except Exception as e:
                cache["data"] = {"error": str(e), "ssids": {}, "devices": []}
            cache["t"] = time.time()
        return cache["data"]


class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_GET(self):
        global last_hit
        path = self.path.split("?")[0]
        if TOKEN:
            if not path.startswith(f"/{TOKEN}/"):
                self.send_error(404)
                return
            path = path[len(TOKEN) + 1:]
        last_hit = time.time()
        if path.startswith("/data"):
            body, ctype = json.dumps(get_data()).encode(), "application/json"
        elif path.startswith("/ausrichten"):
            body, ctype = AUSRICHTEN.encode(), "text/html; charset=utf-8"
        else:
            body, ctype = PAGE.encode(), "text/html; charset=utf-8"
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)


def port_in_use():
    with socket.socket() as s:
        return s.connect_ex(("127.0.0.1", LAN_PORT if LAN else PORT)) == 0


def lan_token():
    try:
        return open(TOKEN_FILE).read().strip()
    except OSError:
        import secrets
        os.makedirs(os.path.dirname(TOKEN_FILE), exist_ok=True)
        t = secrets.token_urlsafe(9)
        with open(os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT, 0o600), "w") as f:
            f.write(t)
        return t


def lan_ip():
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.connect((ROUTER_IP, 9))
        return s.getsockname()[0]


TOKEN = lan_token() if LAN else ""


def serve():
    srv = http.server.ThreadingHTTPServer(("0.0.0.0", LAN_PORT) if LAN else ("127.0.0.1", PORT), H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    while time.time() - last_hit < (LAN_IDLE if LAN else IDLE_EXIT):
        time.sleep(5)
    srv.shutdown()


