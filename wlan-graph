  const ring = (a, b, col) => { mx.globalAlpha = .09; mx.fillStyle = col; mx.beginPath(); mx.arc(cx,cy,rad(b),0,TAU); if (a < -30) { mx.moveTo(cx+rad(a),cy); mx.arc(cx,cy,rad(a),TAU,0,true); } mx.fill(); };
  ring(-30, -60, css('--good')); ring(-60, -70, css('--ok')); if (outer < -70) ring(-70, outer, css('--bad'));
  mx.globalAlpha = 1; mx.strokeStyle = line; mx.setLineDash([3,4]); mx.font = '10px system-ui'; mx.fillStyle = dim; mx.textAlign = 'left';
  for (let r = -40; r >= outer; r -= 10){ mx.beginPath(); mx.arc(cx,cy,rad(r),0,TAU); mx.stroke(); mx.fillText(r, cx+rad(r)*0.71+3, cy-rad(r)*0.71-2); }
  mx.setLineDash([]);
  mx.fillStyle = fg; mx.beginPath(); mx.arc(cx,cy,6,0,TAU); mx.fill();
  if (!devs.length){ mx.fillStyle = dim; mx.textAlign = 'center'; mx.fillText('keine Geräte', cx, cy+22); return; }
  const names = [...new Set(devs.map(d => d.ssid))].sort();
  const by = Object.fromEntries(names.map(n => [n, devs.filter(d => d.ssid === n).sort((a,b) => a.mac < b.mac ? -1 : 1)]));
  const tot = devs.length; let a0 = -Math.PI/2 - Math.PI*by[names[0]].length/tot;
