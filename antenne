#!/usr/bin/env python3
"""antenne – hilft beim Ausrichten der WLAN-Antennen.

Zeigt live eine Punktzahl (Download + Upload in Mbit/s). Antennen drehen,
ein paar Sekunden warten, Zahl ablesen. Mit 1-9 Stellungen speichern.
"""
import os, re, select, signal, subprocess, sys, termios, time, tty
from collections import deque

AVG_SAMPLES = 8          # 8 x 0,5 s = 4 s Mittelwert
TICK = 0.5

ESC = "\033["
RST, BLD, DIM = ESC + "0m", ESC + "1m", ESC + "2m"
RED, GRN, YEL, CYN, MAG = ESC + "31m", ESC + "32m", ESC + "33m", ESC + "36m", ESC + "35m"


def ping_target():
    """Ziel fuer den Hintergrund-Ping: $ANTENNE_TARGET oder das Standard-Gateway (der Router)."""
    if os.environ.get("ANTENNE_TARGET"):
        return os.environ["ANTENNE_TARGET"]
    out = subprocess.run(["ip", "route", "show", "default"], capture_output=True, text=True).stdout
    m = re.search(r"via (\S+)", out)
    return m.group(1) if m else None


def wifi_iface():
    out = subprocess.run(["iw", "dev"], capture_output=True, text=True).stdout
    m = re.search(r"Interface (\S+)", out)
    return m.group(1) if m else None


def parse_rate(line):
    m = re.search(r"([\d.]+) MBit/s", line)
    nss = re.search(r"(?:HE|EHT|VHT)-NSS (\d)", line) or re.search(r"VHT-NSS (\d)", line)
    mcs = re.search(r"(HE|EHT|VHT)-MCS (\d+)", line)
    width = re.search(r"(\d+)MHz", line)
    if not m or not nss or not mcs:   # Management-Frames (6 Mbit/s) ignorieren
        return None
    return (float(m.group(1)), int(nss.group(1)), f"{mcs.group(1)}-MCS {mcs.group(2)}",
            int(mcs.group(2)), int(width.group(1)) if width else 20, mcs.group(1))


MOD = ["BPSK", "QPSK", "QPSK", "16-QAM", "16-QAM", "64-QAM", "64-QAM", "64-QAM",
       "256-QAM", "256-QAM", "1024-QAM", "1024-QAM", "4096-QAM", "4096-QAM"]
GEN = {"EHT": "Wi-Fi 7", "HE": "Wi-Fi 6", "VHT": "Wi-Fi 5"}
EIGHTHS = " ▁▂▃▄▅▆▇█"


def mcs_chart(rx, tx, height=7, top=13):
    """Zwei MCS-Verlaeufe (0..13) uebereinander: Download gruen, Upload magenta."""
    rows = []
    for title, vals, color in (("Download ↓", rx, GRN), ("Upload   ↑", tx, MAG)):
        cur = vals[-1] if vals else 0
        lo, hi = (min(vals), max(vals)) if vals else (0, 0)
        avg = sum(vals) / len(vals) if vals else 0
        jumps = sum(1 for a, b in zip(vals, list(vals)[1:]) if a != b)
        rows.append(f"  {BLD}{title}{RST}  jetzt {BLD}MCS {cur}{RST} ({MOD[cur]})   "
                    f"{DIM}min {lo} · Ø {avg:.1f} · max {hi} · {jumps} Wechsel{RST}\n")
        for r in range(height - 1, -1, -1):
            lvl_top = (r + 1) * top / height
            label = f"{round(lvl_top):>2} ┤" if r % 2 == 0 or r == height - 1 else "   │"
            line = ""
            for v in vals:
                fill = v / top * height - r
                line += "█" if fill >= 1 else (EIGHTHS[max(0, int(fill * 8))] if fill > 0 else " ")
            rows.append(f"  {DIM}{label}{RST}{color}{line}{RST}\n")
        rows.append(f"  {DIM} 0 └{'─' * len(vals)}{RST}\n")
    rows.append(f"  {DIM}      ← {len(rx) * TICK:.0f} s Verlauf · höher = mehr Daten pro Funksignal{RST}\n")
    return "".join(rows)


def band(mhz):
    return "2,4 GHz" if mhz < 3000 else "5 GHz" if mhz < 5925 else "6 GHz"


def links(iface):
    """Aktive Funkverbindungen (bei Wi-Fi 7 MLO evtl. mehrere): [(Band, Kanal, MHz)]."""
    out = subprocess.run(["iw", "dev", iface, "info"], capture_output=True, text=True).stdout
    return [(band(int(f)), int(ch), int(f)) for ch, f in re.findall(r"channel (\d+) \((\d+) MHz\)", out)]


def sample(iface):
    out = subprocess.run(["iw", "dev", iface, "station", "dump"], capture_output=True, text=True).stdout
    s = {"links": links(iface)}
    m = re.search(r"^\s*signal:\s*(-?\d+)\s*\[([^\]]*)\]", out, re.M)
    if m:
        s["sig"] = int(m.group(1))
        s["chains"] = [int(x) for x in m.group(2).split(",")]
    for key in ("rx", "tx"):
        m = re.search(rf"^\s*{key} bitrate:\s*(.*)$", out, re.M)
        if m:
            s[key] = parse_rate(m.group(1))
    return s


def bar(v, lo, hi, w, color):
    n = max(0, min(w, round((v - lo) / (hi - lo) * w)))
    return color + "█" * n + DIM + "░" * (w - n) + RST


def sig_color(v):
    return GRN if v >= -60 else YEL if v >= -70 else RED


def main():
    iface = wifi_iface()
    if not iface:
        sys.exit("Kein WLAN-Interface gefunden.")
    # etwas Verkehr erzeugen, damit die Datenraten aktuell bleiben
    target = ping_target()
    ping = subprocess.Popen(["ping", "-q", "-i", "0.05", "-s", "1400", target],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) if target else None
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    tty.setcbreak(fd)
    sys.stdout.write(ESC + "?25l" + ESC + "2J")

    last = {"rx": None, "tx": None}
    hist = deque(maxlen=AVG_SAMPLES)
    chains_hist = deque(maxlen=AVG_SAMPLES)
    trend = deque(maxlen=60)
    mcs_rx, mcs_tx = deque(maxlen=60), deque(maxlen=60)
    saved = {}
    best = 0
    msg = ""
    try:
        while True:
            s = sample(iface)
            last["links"] = s["links"]
            for k in ("rx", "tx"):
                if s.get(k):
                    last[k] = s[k]
            if last["rx"] and last["tx"]:
                hist.append(last["rx"][0] + last["tx"][0])
                mcs_rx.append(last["rx"][3]); mcs_tx.append(last["tx"][3])
            if s.get("chains"):
                chains_hist.append(s["chains"])
            score = round(sum(hist) / len(hist)) if hist else 0
            best = max(best, score) if len(hist) == AVG_SAMPLES else best
            trend.append(score)
            chains = [round(sum(c[i] for c in chains_hist) / len(chains_hist))
                      for i in range(len(chains_hist[0]))] if chains_hist else []
            streams = (last["rx"][1] if last["rx"] else 0, last["tx"][1] if last["tx"] else 0)

            # Taste gedrueckt?
            while select.select([sys.stdin], [], [], 0)[0]:
                c = sys.stdin.read(1)
                if c in "qQ":
                    return
                if c.isdigit() and c != "0":
                    saved[c] = (score, chains, streams)
                    msg = f"Stellung {c} gespeichert: {score}"
                if c in "rR":
                    saved.clear(); best = 0; msg = "Zurückgesetzt"

            o = [ESC + "H" + ESC + "J"]
            o.append(f"{BLD}{CYN}  ANTENNEN-EINSTELLER{RST}  {DIM}({iface}){RST}\n")
            o.append(f"  {DIM}So geht's: Antenne ein Stück drehen → Hände weg → 5 Sekunden warten → Zahl ablesen.{RST}\n")
            o.append(f"  {DIM}Größere Zahl = schnelleres WLAN. Gute Stellung mit Taste 1-9 merken.{RST}\n\n")

            big = f"{score:>5}"
            col = GRN if best and score >= best * 0.95 else YEL if best and score >= best * 0.8 else RED if best else CYN
            ref = last["rx"] or last["tx"]
            maxrate = (ref[4] * 18) if ref else 2400          # ~Max. fuer 2x2 bei dieser Kanalbreite
            if ref:
                o.append(f"  {BLD}{GEN.get(ref[5], ref[5])}{RST} · {ref[4]} MHz Kanal · max. ca. {maxrate:.0f} Mbit/s pro Richtung\n")
            lk = last.get("links") or []
            if lk:
                bands = " + ".join(f"{BLD}{b}{RST} (Kanal {ch}, {f} MHz)" for b, ch, f in lk)
                o.append(f"  Funkband     {bands}  {DIM}← Download und Upload laufen beide hierüber{RST}\n")
            o.append("\n")
            o.append(f"  PUNKTZAHL   {BLD}{col}{big}{RST}   {bar(score, 0, 2 * maxrate, 30, col)}\n")
            sp = "▁▂▃▄▅▆▇█"
            hi = max(max(trend), 1)
            o.append(f"  Verlauf     {CYN}{''.join(sp[min(7, int(v / hi * 7))] for v in trend)}{RST}\n")
            o.append(f"  Bestwert    {best}\n\n")

            for label, key in (("Download", "rx"), ("Upload  ", "tx")):
                r = last[key]
                if r:
                    st = f"{GRN}2 Ströme ✓{RST}" if r[1] >= 2 else f"{YEL}1 Strom{RST}"
                    o.append(f"  {label} {r[0]:7.0f} Mbit/s  {bar(r[0], 0, maxrate, 20, GRN if r[1] >= 2 else YEL)}  {st}  {DIM}{r[2]}{RST}\n")
                else:
                    o.append(f"  {label}   warte auf Daten ...\n")
            o.append("\n")
            for i, v in enumerate(chains):
                o.append(f"  Antenne {'AB'[i] if i < 2 else i}  {sig_color(v)}{v:4d} dBm{RST}  {bar(v, -90, -30, 20, sig_color(v))}\n")
            o.append("\n")

            if mcs_rx:
                o.append(mcs_chart(mcs_rx, mcs_tx) + "\n")

            if streams[0] >= 2 and streams[1] >= 2:
                tip = f"{GRN}Super – beide Richtungen nutzen 2 Ströme. Diese Stellung ist gut.{RST}"
            elif max(streams) >= 2:
                tip = f"{YEL}Eine Richtung hat schon 2 Ströme. Leicht nachjustieren.{RST}"
            else:
                tip = f"{YEL}Nur 1 Strom. Probier: eine Antenne senkrecht, die andere waagerecht.{RST}"
            o.append(f"  Tipp: {tip}\n\n")

            if saved:
                top = max(v[0] for v in saved.values())
                o.append(f"  {BLD}Gespeicherte Stellungen:{RST}\n")
                for k in sorted(saved):
                    sc, ch, st = saved[k]
                    mark = f" {GRN}◀ beste{RST}" if sc == top else ""
                    chs = "  ".join(f"{'AB'[i] if i < 2 else i} {v} dBm" for i, v in enumerate(ch))
                    o.append(f"   {k}: {BLD}{sc:5}{RST}  {DIM}({chs}, Ströme ↓{st[0]} ↑{st[1]}){RST}{mark}\n")
                o.append("\n")
            if msg:
                o.append(f"  {CYN}{msg}{RST}\n")
            o.append(f"  {DIM}[1-9] Stellung speichern   [r] zurücksetzen   [q] beenden{RST}\n")
            sys.stdout.write("".join(o))
            sys.stdout.flush()
            time.sleep(TICK)
    finally:
        if ping:
            ping.terminate()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write(ESC + "?25h\n")


if __name__ == "__main__":
    # Fenster schliessen / kill: sauber beenden, damit der Ping nicht weiterlaeuft
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: sys.exit(0))
    try:
        main()
    except KeyboardInterrupt:
        pass
